# Copy to .env for local development (never commit .env).

# --- Django mode ---
# local | test | prod
DJANGO_ENV=local
DEBUG=True

# --- Core Django ---
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=.run.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.run.app,http://localhost:8000,http://127.0.0.1:8000
SITE_ID=1

# --- Database (Supabase) ---
# Runtime (transaction pooler, port 6543, SSL). Used by Django + Bolt on Cloud Run.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Direct Postgres (port 5432, SSL). Used only by the migration Cloud Run Job (DIRECT_URL).
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- Email (django-invitations + SMTP) ---
DEFAULT_FROM_EMAIL=Worship Prep <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Google OAuth (django-allauth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API keys ---
# Machine-to-machine API keys are issued from the Django admin portal and stored
# in the database. No static API key secret is configured through Django env vars.

# --- Supabase Storage (S3-compatible; both buckets are required in production) ---
SUPABASE_STORAGE_BUCKET=
SUPABASE_CATALOG_IMPORT_BUCKET=
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-east-1

# --- Cloud Run / Bolt ---
# Port injected by Cloud Run (defaults below are for local scripts).
PORT=8080
# Bolt worker processes (match Cloud Run CPU).
BOLT_PROCESSES=1
# Gunicorn workers for Django service.
WEB_CONCURRENCY=2

# --- Optional ---
# STATIC_ROOT / MEDIA_ROOT use public/static and public/media under the project when unset.

# --- Health checks (local compose) ---
# Django WSGI:  http://localhost:8000/health  (liveness), /ready (DB + storage)
# Bolt API:    http://localhost:8001/api/v1/health  and  /api/v1/ready
