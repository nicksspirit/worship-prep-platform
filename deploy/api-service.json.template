{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": ${API_NAME},
    "namespace": ${PROJECT_ID},
    "annotations": {"run.googleapis.com/ingress": "all"}
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/maxScale": "20",
          "run.googleapis.com/startup-cpu-boost": "true",
          "run.googleapis.com/container-dependencies": "{\"ingress\":[\"bolt\"]}"
        }
      },
      "spec": {
        "serviceAccountName": ${RUNTIME_SA},
        "containerConcurrency": 1,
        "timeoutSeconds": 600,
        "containers": [
          {
            "name": "ingress",
            "image": ${INGRESS_IMAGE},
            "ports": [{"name": "h2c", "containerPort": 8080}],
            "env": [{"name": "GCP_PROJECT_ID", "value": ${PROJECT_ID}}],
            "resources": {"limits": {"cpu": "1", "memory": "256Mi"}},
            "startupProbe": {
              "httpGet": {"path": "/api/v1/docs", "port": 8080},
              "periodSeconds": 2,
              "timeoutSeconds": 2,
              "failureThreshold": 60
            }
          },
          {
            "name": "bolt",
            "image": ${PROD_IMAGE},
            "command": ["/bin/bash"],
            "args": ["deploy/start-bolt.sh"],
            "env": ${BOLT_ENV},
            "resources": {"limits": {"cpu": "1", "memory": "2Gi"}},
            "startupProbe": {
              "httpGet": {"path": "/api/v1/docs", "port": 8000},
              "periodSeconds": 2,
              "timeoutSeconds": 2,
              "failureThreshold": 60
            }
          }
        ]
      }
    },
    "traffic": [{"latestRevision": true, "percent": 100}]
  }
}
