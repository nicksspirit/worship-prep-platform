worker_processes 1;
pid /tmp/wpp-nginx.pid;
error_log stderr;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    include /tmp/wpp-nginx-logging.conf;
    client_body_temp_path /tmp/wpp-nginx-body;
    proxy_temp_path /tmp/wpp-nginx-proxy;
    fastcgi_temp_path /tmp/wpp-nginx-fastcgi;
    uwsgi_temp_path /tmp/wpp-nginx-uwsgi;
    scgi_temp_path /tmp/wpp-nginx-scgi;
    # The package limit is 128 MiB; allow events and multipart framing too.
    client_max_body_size 130m;

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    upstream bolt {
        server __BOLT_ADDRESS__;
        keepalive 16;
    }

    server {
        listen __PORT__;
        # Request error diagnostics include raw URLs; access logs record failures safely.
        error_log /dev/null;
        http2 on;

        location /api/ {
            proxy_pass https://bolt;
            proxy_set_header X-Request-ID $wpp_request_id;
            proxy_set_header X-Cloud-Trace-Context $wpp_trace_context;
            proxy_set_header Host __BOLT_HOST__;
            proxy_ssl_server_name on;
            proxy_ssl_name __BOLT_HOST__;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_http_version 2;
            proxy_set_header Connection "";
            proxy_request_buffering off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header X-Request-ID $wpp_request_id;
            proxy_set_header X-Cloud-Trace-Context $wpp_trace_context;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
