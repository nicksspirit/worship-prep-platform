worker_processes 1;
pid /tmp/wpp-nginx.pid;
error_log stderr;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    log_format structured escape=json '{"event":"request_finished","method":"$request_method",'
        '"path":"$uri","status":$status,"duration":$request_time,'
        '"upstream_status":"$upstream_status","upstream_duration":"$upstream_response_time",'
        '"request_id":"$wpp_request_id","logging.googleapis.com/trace":"$cloud_trace"}';
    access_log /dev/stdout structured;

    map $http_x_request_id $wpp_request_id {
        default $request_id;
        "~^[A-Za-z0-9_-]{1,64}$" $http_x_request_id;
    }
    map $http_x_cloud_trace_context $wpp_trace_context {
        default "$request_id/0;o=0";
        "~^00000000000000000000000000000000/" "$request_id/0;o=0";
        "~^[0-9a-f]{32}/[0-9]{1,20}(;o=[01])?$" $http_x_cloud_trace_context;
    }
    map $wpp_trace_context $wpp_trace_id {
        "~^([0-9a-f]{32})/" $1;
    }
    map "__GCP_PROJECT_ID__:$wpp_trace_id" $cloud_trace {
        default "";
        "~^[a-z][a-z0-9-]{4,61}[a-z0-9]:[0-9a-f]{32}$" "projects/__GCP_PROJECT_ID__/traces/$wpp_trace_id";
    }
    client_body_temp_path /tmp/wpp-nginx-body;
    proxy_temp_path /tmp/wpp-nginx-proxy;
    fastcgi_temp_path /tmp/wpp-nginx-fastcgi;
    uwsgi_temp_path /tmp/wpp-nginx-uwsgi;
    scgi_temp_path /tmp/wpp-nginx-scgi;
    # The package limit is 128 MiB; allow events and multipart framing too.
    client_max_body_size 130m;

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    upstream bolt {
        server __BOLT_ADDRESS__;
        keepalive 16;
    }

    server {
        listen __PORT__;
        # Request error diagnostics include raw URLs; access logs record failures safely.
        error_log /dev/null;

        location /api/ {
            proxy_pass https://bolt;
            proxy_set_header X-Request-ID $wpp_request_id;
            proxy_set_header X-Cloud-Trace-Context $wpp_trace_context;
            proxy_set_header Host __BOLT_HOST__;
            proxy_ssl_server_name on;
            proxy_ssl_name __BOLT_HOST__;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_request_buffering off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header X-Request-ID $wpp_request_id;
            proxy_set_header X-Cloud-Trace-Context $wpp_trace_context;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
